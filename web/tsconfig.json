{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["vitest/globals", "svelte", "vite/client"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vitest.config.ts"]
}
